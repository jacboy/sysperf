#!/usr/bin/env bash
#
# getsysperf.com
# A simple benchmark script to test your Disk, Network and CPU performance
#

SYSPERF_VERSION="2.0.0"

# Everything below runs inside main(), which is only called on the very last line. If the
# download breaks off while the script is piped into bash ("curl ... | bash"), bash sees an
# incomplete function and runs nothing, instead of running the first half of the script.
main() {


#
#
# VALIDATION
#
#

# Check if at least Debian 10 or Ubuntu 1904 is used
if grep -qs "ubuntu" /etc/os-release; then
	os="ubuntu"
	os_version=$(grep 'VERSION_ID' /etc/os-release | cut -d '"' -f 2 | tr -d '.')
	group_name="nogroup"
elif [[ -e /etc/debian_version ]]; then
	os="debian"
	os_version=$(grep -oE '[0-9]+' /etc/debian_version | head -1)
	group_name="nogroup"
else
	echo "Looks like you aren't running this installer on Debian or Ubuntu"
	exit
fi
if [[ "$os" == "ubuntu" && "$os_version" -lt 1804 ]]; then
	echo "Ubuntu 18.04 or higher is required to use this installer
This version of Ubuntu is too old and unsupported"
	exit
fi

if [[ "$os" == "debian" && "$os_version" -lt 10 ]]; then
	echo "Debian 10 or higher is required to use this installer
This version of Debian is too old and unsupported"
	exit
fi

# Check if the required packages are installed. Root is only needed to install them.
if ! command -v wget >/dev/null || ! command -v fio >/dev/null || ! command -v curl >/dev/null || ! command -v jq >/dev/null || ! command -v ping >/dev/null || ! command -v sysbench >/dev/null; then
    echo "Couldn't find [wget, fio, curl, jq, ping, sysbench]"
    if [[ "$EUID" -ne 0 ]]; then
        echo "Please install them first: apt install ca-certificates curl jq fio wget iputils-ping sysbench"
        exit 1
    fi
    # Ask on the terminal: when run as "curl ... | bash", stdin is the script itself. Without
    # a terminal (cron, CI) there is nobody to ask, so don't install anything unasked.
    if ! { : < /dev/tty; } 2>/dev/null; then
        echo "No terminal to ask for confirmation. Please install them first:"
        echo "apt-get install -y ca-certificates curl jq fio wget iputils-ping sysbench"
        exit 1
    fi
    read -r -p "Install the missing packages with apt-get now? [Y/n] " install_answer < /dev/tty
    case "$install_answer" in
        ""|[Yy]|[Yy][Ee][Ss]) ;;
        *)
            echo "Not installing anything. To install them yourself:"
            echo "apt-get install -y ca-certificates curl jq fio wget iputils-ping sysbench"
            exit 1 ;;
    esac
    apt-get update && apt-get install -y ca-certificates curl jq fio wget iputils-ping sysbench || exit 1
fi

# The working directory goes into the current directory, so the I/O test measures that
# disk. That's only safe if no other user can rename anything on the path to it: in a
# directory that others can write to without the sticky bit (or that another user owns),
# they could swap our directory for their own and redirect root's writes, or replace the
# Geekbench binary before it runs. So every directory from / down to here must be owned
# by root or by us, and must not be group/world-writable unless it has the sticky bit.
here=$( pwd -P )
check_dir="$here"
while :; do
    dir_mode=$( stat -c '%a' "$check_dir" ) || exit 1
    dir_owner=$( stat -c '%u' "$check_dir" ) || exit 1
    if { [ "$dir_owner" != 0 ] && [ "$dir_owner" != "$EUID" ]; } \
        || { (( 8#$dir_mode & 8#022 )) && ! (( 8#$dir_mode & 8#1000 )); }; then
        printf 'Error: other users can modify %s, so it is not safe to run the benchmark in %s.\n' "$check_dir" "$here"
        echo "Please run it from a directory only you (or root) can change, for example: cd ~"
        exit 1
    fi
    [ "$check_dir" = / ] && break
    check_dir=$( dirname "$check_dir" )
done

# Private working directory for the I/O test file and Geekbench, with an unpredictable
# name and mode 0700, so other local users can't pre-plant files or symlinks in it.
WORKDIR=$( mktemp -d "${here}/.sysperf.XXXXXXXX" ) || { echo "Error: cannot create a working directory in ${here}"; exit 1; }
trap 'spinner_stop; rm -rf -- "$WORKDIR"' EXIT
trap 'exit 130' INT TERM

# Progress spinner, so it's visible that a long step is still running. It is drawn on
# the terminal (/dev/tty) only, never on stdout, so "| tee log" output stays clean.
# Without a terminal (e.g. cron) it is skipped.
SPIN_PID=""
if { : > /dev/tty; } 2>/dev/null; then
    exec 3> /dev/tty
    SPIN_TTY=1
else
    SPIN_TTY=0
fi
if [[ "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" =~ [Uu][Tt][Ff]-?8 ]]; then
    SPIN_FRAMES=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
else
    SPIN_FRAMES=('|' '/' '-' '\')
fi

spinner_start() {
    [ "$SPIN_TTY" = 1 ] || return 0
    spinner_stop
    local label=$1
    (
        trap 'exit 0' TERM
        # Short delay so the previous result line is printed (e.g. through tee) first
        sleep 0.3
        local i=0 start=$SECONDS
        while :; do
            printf '\r\033[K\033[0;36m%s\033[0m %s (%ss)' "${SPIN_FRAMES[i % ${#SPIN_FRAMES[@]}]}" "$label" "$(( SECONDS - start ))" >&3
            i=$(( i + 1 ))
            sleep 0.2
        done
    ) &
    SPIN_PID=$!
}

spinner_stop() {
    [ -n "$SPIN_PID" ] || return 0
    kill "$SPIN_PID" 2>/dev/null
    wait "$SPIN_PID" 2>/dev/null
    SPIN_PID=""
    printf '\r\033[K' >&3
}

# Test IPv6 connectivity
ipv6=$( wget -qO- -t1 -T2 https://ipv6.icanhazip.com )


# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;36m'
PLAIN='\033[0m'


#
#
# FUNCTIONS
#
#

# Strip control characters (e.g. terminal escape sequences) from untrusted text
sanitize() {
    LC_ALL=C tr -cd '[:print:]'
}

get_netinfo() {
    # ipinfo.io looks up the caller's own address over HTTPS, so no IP from another
    # response is ever put into a URL. "org" looks like "AS3320 Deutsche Telekom AG".
    local org
    org=$( curl -fsS --proto '=https' --max-time 10 https://ipinfo.io/json 2>/dev/null | jq -r '.org // empty' 2>/dev/null | sanitize )
    as="$org"
    isp="${org#AS* }"
}

get_opsy() {
    [ -f /etc/redhat-release ] && awk '{print ($1,$3~/^[0-9]/?$3:$4)}' /etc/redhat-release && return
    [ -f /etc/os-release ] && awk -F'[= "]' '/PRETTY_NAME/{print $3,$4,$5}' /etc/os-release && return
    [ -f /etc/lsb-release ] && awk -F'[="]+' '/DESCRIPTION/{print $2}' /etc/lsb-release && return
}
get_sys_type() {
    local virt
    virt=$( systemd-detect-virt 2>/dev/null )
    case "$virt" in
        none)   sys_type="Baremetal" ;;
        kvm)    sys_type="KVM" ;;
        lxc)    sys_type="LXC" ;;
        openvz) sys_type="OpenVZ" ;;
        "")     sys_type="Unknown" ;;
        *)      sys_type="$virt" ;;
    esac
}

next() {
    printf "%-5s\n" "-" | sed 's/\s/-/g'
}

speed_test() {
    # Fetch the first 100 MB (range request, so 1 GB test files work too), at most 15s per
    # host; the speed is averaged over what arrived. curl falls back from a dead IPv6
    # address to IPv4 quickly (happy eyeballs).
    spinner_start "Downloading from $2"
    local result code bytes bps speed
    result=$(curl -s -o /dev/null -r 0-104857599 --connect-timeout 5 --max-time 15 \
        -w '%{http_code} %{size_download} %{speed_download}' "$1" 2>/dev/null)
    spinner_stop
    read -r code bytes bps <<< "$result"
    if { [ "$code" = 200 ] || [ "$code" = 206 ]; } && [ "${bytes%.*}" -gt 1048576 ] 2>/dev/null; then
        speed=$(awk -v b="$bps" 'BEGIN { if (b >= 1048576) printf "%.1f MB/s", b / 1048576; else printf "%.0f KB/s", b / 1024 }')
    else
        speed="failed"
    fi
    printf "${YELLOW}%-32s${GREEN}%-24s${RED}%-14s${PLAIN}\n" "$2" "$speed"
}

