ping_test() {
    local nodename=$2
    spinner_start "Pinging $2"
    local output=$(ping -w 2 "$1" 2>/dev/null | grep rtt | cut -d'/' -f4 | awk '{ print $3 }')
    # Some test hosts publish an IPv6 address that doesn't answer; retry over IPv4
    [ -z "$output" ] && output=$(ping -4 -w 2 "$1" 2>/dev/null | grep rtt | cut -d'/' -f4 | awk '{ print $3 }')
    spinner_stop
    if [ -n "$output" ]; then output="$output ms"; else output="failed"; fi
    printf "${YELLOW}%-32s${GREEN}%-24s${RED}%-14s${PLAIN}\n" "${nodename}" "${output}"
}

