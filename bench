io_test() {
   # Run rand read/write mixed 512kb fio test
   local testfile="$WORKDIR/fio_iotest"
   fio --name=rand_rw_512k --ioengine=libaio --rw=randrw --rwmixread=50 --bs=512k --iodepth=64 --numjobs=2 --size=2G --runtime=30 --gtod_reduce=1 --direct=1 --filename="$testfile" | grep "WRITE:" | awk '{print $3}' | sed 's/,//g' | sed 's/(//g' | sed 's/)//g'
   rm -f -- "$testfile"
   sleep 10
}


# CPU benchmark with sysbench (from the distribution's own packages). Always runs.
cpu_bench() {
	local threads single multi
	threads=$(nproc)
	spinner_start "Running CPU benchmark (single core)"
	single=$(sysbench cpu --cpu-max-prime=20000 --threads=1 --time=10 run 2>/dev/null | awk -F: '/events per second/ {gsub(/ /, "", $2); print $2}')
	spinner_stop
	spinner_start "Running CPU benchmark (${threads} threads)"
	multi=$(sysbench cpu --cpu-max-prime=20000 --threads="$threads" --time=10 run 2>/dev/null | awk -F: '/events per second/ {gsub(/ /, "", $2); print $2}')
	spinner_stop
	echo "CPU benchmark (sysbench, events per second, higher is better)"
	printf "Single Core          : ${BLUE}%s${PLAIN}\n" "${single:-failed}"
	printf "Multi Core           : ${YELLOW}%s${PLAIN} (%s threads)\n" "${multi:-failed}" "$threads"
}

# Optional Geekbench 7 CPU benchmark, only downloaded and run when GEEKBENCH=7 (or 1) is set.
# It needs ~1.5 GB free disk while running (462 MB tarball + 963 MB extracted).
# Geekbench 6 is not offered: its free version shows no scores locally, only after the
# upload to the Geekbench Browser, and that upload failed in testing.
GB7_MIN_FREE_MB=1536

geekbench() {
	case "${GEEKBENCH:-}" in
		""|0) return 0 ;;
		1|7)  ;;
		*)
			printf "Geekbench            : skipped (unknown GEEKBENCH value '%s', use GEEKBENCH=7)\n" "$GEEKBENCH"
			return 0 ;;
	esac

	# Check if system has at least 2GB RAM in order to run Geekbench
	local ram
	ram=$(free -m | awk '/Mem/ {print $2}')
	if [ "$ram" -lt 2048 ]; then
		echo "Geekbench            : skipped (${ram} MB RAM, at least 2 GB is required)"
		return 0
	fi

	local suffix
	case "$(uname -m)" in
		x86_64)        suffix="Linux" ;;
		aarch64|arm64) suffix="LinuxARMPreview" ;;
		*)
			echo "Geekbench            : skipped (no Geekbench build for $(uname -m))"
			return 0 ;;
	esac

	local free_mb version="7.1.0"
	free_mb=$(df -Pm "$WORKDIR" | awk 'NR==2 {print $4}')
	if [ "$free_mb" -lt "$GB7_MIN_FREE_MB" ]; then
		echo "Geekbench            : skipped (only ${free_mb} MB free disk, Geekbench 7 needs 1.5 GB)"
		return 0
	fi

	# SHA-256 of the official tarballs, downloaded over HTTPS from cdn.geekbench.com on 2026-11-09
	local sha256
	case "${version}-${suffix}" in
		7.1.0-Linux)           sha256="411b72a9c851b69e6f91d390649d419e2e625f475e3983880169651ca27a8672" ;;
		7.1.0-LinuxARMPreview) sha256="bb6abc61a68a9b33fecf1f3c0b800050dd76e93666a13eaabfa52cbd26ad3319" ;;
	esac

	local major=${version%%.*}
	local url="https://cdn.geekbench.com/Geekbench-${version}-${suffix}.tar.gz"
	local tarball="$WORKDIR/geekbench.tar.gz"
	local gbdir="$WORKDIR/geekbench"
	local gbout="$WORKDIR/geekbench.out"

	# TODO: disable the upload to the public Geekbench Browser (to be fixed with the next
	# changes to the script). Geekbench only runs when GEEKBENCH is set, but then the free
	# version always uploads: `geekbench7 --help` only lists --unlock EMAIL KEY, --cpu and
	# --sysinfo, and Primate Labs requires Geekbench Pro for offline use. So it needs a
	# user-supplied Pro license (--unlock). The scores are already read from the local
	# output, so nothing else depends on the upload.
	echo "Note: Geekbench uploads the result and basic system information to the public Geekbench Browser."

	spinner_start "Downloading Geekbench ${version}"
	curl -fsSL --proto '=https' --max-time 900 -o "$tarball" "$url"
	local rc=$?
	spinner_stop
	if [ "$rc" -ne 0 ]; then
		echo "Error: Geekbench download failed, skipping the CPU benchmark"
		return 1
	fi
	if ! echo "$sha256  $tarball" | sha256sum -c --quiet - >/dev/null 2>&1; then
		echo "Error: Geekbench download does not match the expected SHA-256 checksum, not running it"
		rm -f -- "$tarball"
		return 1
	fi
	mkdir -p "$gbdir"
	spinner_start "Extracting Geekbench ${version}"
	tar xzf "$tarball" --strip-components=1 -C "$gbdir"
	rc=$?
	spinner_stop
	rm -f -- "$tarball"
	if [ "$rc" -ne 0 ] || [ ! -x "$gbdir/geekbench${major}" ]; then
		echo "Error: could not extract Geekbench, skipping the CPU benchmark"
		rm -rf -- "$gbdir"
		return 1
	fi

	spinner_start "Running Geekbench ${version} CPU benchmark, this takes a few minutes"
	"$gbdir/geekbench${major}" > "$gbout" 2>/dev/null
	spinner_stop

	local result_url single multi
	result_url=$(grep -oE 'https://browser\.geekbench\.com/v[0-9]+/cpu/[0-9]+' "$gbout" | head -1)
	single=$(awk '/Single-Core Score/ {print $NF; exit}' "$gbout" | tr -cd '0-9')
	multi=$(awk '/Multi-Core Score/ {print $NF; exit}' "$gbout" | tr -cd '0-9')
	rm -rf -- "$gbdir" "$gbout"

	if [ -z "$single" ] && [ -z "$result_url" ]; then
		echo "Error: Geekbench did not report a result"
		return 1
	fi
	echo -e "Geekbench v${version}"
	echo -e "Single Core          : ${BLUE}${single:-n/a}${PLAIN}"
	echo -e "Multi Core           : ${YELLOW}${multi:-n/a}${PLAIN}"
	[ -n "$result_url" ] && echo -e "Full result          : ${result_url}"
	return 0
}

calc_disk() {
    local total_size=0
    local array=$@
    for size in ${array[@]}
    do
        [ "${size}" == "0" ] && size_t=0 || size_t=`echo ${size:0:${#size}-1}`
        [ "`echo ${size:(-1)}`" == "K" ] && size=0
        [ "`echo ${size:(-1)}`" == "M" ] && size=$( awk -v s="$size_t" 'BEGIN{printf "%.1f", s / 1024}' )
        [ "`echo ${size:(-1)}`" == "T" ] && size=$( awk -v s="$size_t" 'BEGIN{printf "%.1f", s * 1024}' )
        [ "`echo ${size:(-1)}`" == "G" ] && size=${size_t}
        total_size=$( awk -v t="$total_size" -v s="$size" 'BEGIN{printf "%.1f", t + s}' )
    done
    echo ${total_size}
}

cname=$( awk -F: '/model name/ {name=$2} END {print name}' /proc/cpuinfo | sed 's/^[ \t]*//;s/[ \t]*$//' )
cores=$( awk -F: '/model name/ {core++} END {print core}' /proc/cpuinfo )
freq=$( awk -F: '/cpu MHz/ {freq=$2} END {print freq}' /proc/cpuinfo | sed 's/^[ \t]*//;s/[ \t]*$//' )
tram=$( free -m | awk '/Mem/ {print $2}' )
uram=$( free -m | awk '/Mem/ {print $3}' )
swap=$( free -m | awk '/Swap/ {print $2}' )
uswap=$( free -m | awk '/Swap/ {print $3}' )
up=$( awk '{a=$1/86400;b=($1%86400)/3600;c=($1%3600)/60} {printf("%d days, %d hour %d min\n",a,b,c)}' /proc/uptime )
load=$( w | head -1 | awk -F'load average:' '{print $2}' | sed 's/^[ \t]*//;s/[ \t]*$//' )
opsy=$( get_opsy )
arch=$( uname -m )
lbit=$( getconf LONG_BIT )
kern=$( uname -r )
disk_size1=($( LANG=C df -hPl | grep -wvE '\-|none|tmpfs|devtmpfs|by-uuid|chroot|Filesystem|udev|docker' | awk '{print $2}' ))
disk_size2=($( LANG=C df -hPl | grep -wvE '\-|none|tmpfs|devtmpfs|by-uuid|chroot|Filesystem|udev|docker' | awk '{print $3}' ))
disk_total_size=$( calc_disk "${disk_size1[@]}" )
disk_used_size=$( calc_disk "${disk_size2[@]}" )

clear
next
echo -e "${RED}getsysperf.com${PLAIN} v${SYSPERF_VERSION} -- ${YELLOW}https://github.com/jacboy/sysperf${PLAIN}"
next
spinner_start "Collecting system information"
get_netinfo
get_sys_type
spinner_stop
printf "System type          : ${BLUE}%s${PLAIN}\n" "$sys_type"
printf "CPU model            : ${BLUE}%s${PLAIN}\n" "$cname"
printf "Number of cores      : ${BLUE}%s${PLAIN}\n" "$cores"
printf "CPU frequency        : ${BLUE}%s MHz${PLAIN}\n" "$freq"
printf "Total size of Disk   : ${BLUE}%s GB (%s GB Used)${PLAIN}\n" "$disk_total_size" "$disk_used_size"
printf "Total amount of Mem  : ${BLUE}%s MB (%s MB Used)${PLAIN}\n" "$tram" "$uram"
printf "Total amount of Swap : ${BLUE}%s MB (%s MB Used)${PLAIN}\n" "$swap" "$uswap"
printf "System uptime        : ${BLUE}%s${PLAIN}\n" "$up"
printf "Load average         : ${BLUE}%s${PLAIN}\n" "$load"
printf "OS                   : ${BLUE}%s${PLAIN}\n" "$opsy"
printf "Arch                 : ${BLUE}%s (%s Bit)${PLAIN}\n" "$arch" "$lbit"
printf "Kernel               : ${BLUE}%s${PLAIN}\n" "$kern"
printf "ISP                  : ${BLUE}%s${PLAIN}\n" "$isp"
printf "ASN                  : ${BLUE}%s${PLAIN}\n" "$as"
if [[ "$ipv6" != "" ]]; then
echo -e "IPv6 Support         : ${BLUE}Yes${PLAIN}"
else
echo -e "IPv6 Support         : ${BLUE}No${PLAIN}"
fi
next
spinner_start "Running I/O test (1st run)"
io1=$( io_test )
spinner_stop
echo -e "I/O bandwidth (1st run)  : ${YELLOW}$io1${PLAIN}"
spinner_start "Running I/O test (2nd run)"
io2=$( io_test )
spinner_stop
echo -e "I/O bandwidth (2nd run)  : ${YELLOW}$io2${PLAIN}"
spinner_start "Running I/O test (3rd run)"
io3=$( io_test )
